# Copy to .env before starting Docker Compose.
APP_PORT=8080
CLIENT_URL=http://localhost:8080

# Use a long, random alphanumeric password (avoid URI reserved characters).
MONGO_ROOT_USERNAME=fieldhouse
MONGO_ROOT_PASSWORD=replace_with_long_random_alphanumeric_value

# Replace both values with independent random secrets before public deployment.
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
OTP_HASH_SECRET=replace_with_another_long_random_secret

# Required to deliver registration OTP emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: required only for Cloudflare R2 image uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
